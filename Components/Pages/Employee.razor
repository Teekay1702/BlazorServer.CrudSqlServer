@page "/employee"

@using BlazorServer.CrudSqlServer.Services
@using BlazorServer.CrudSqlServer.Models
@rendermode InteractiveServer
@inject EmployeeService employeeService
@using EmployeeModel = BlazorServer.CrudSqlServer.Models.Employee

<h3>Employee Management</h3>

<div class="mb-2">
    <input placeholder="Name" @bind="employee.Name" />
</div>

<div class="mb-2">
    <input placeholder="Email" @bind="employee.Email" />
</div>

<div class="mb-2">
    <input placeholder="Position" @bind="employee.Position" />
</div>

@if (isEditing)
{
    <button @onclick="UpdateEmployee">Update</button>
    <button @onclick="CancelEdit">Cancel</button>
}
else
{
    <button @onclick="SaveEmployee">Save</button>
}

<hr />

<h4>Employee List</h4>

@if (employees == null)
{
    <p>Loading...</p>
}
else if (!employees.Any())
{
    <p>No employees found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Position</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var emp in employees)
            {
                <tr>
                    <td>@emp.Name</td>
                    <td>@emp.Email</td>
                    <td>@emp.Position</td>
                    <td>
                        <button @onclick="() => EditEmployee(emp)">
                            Edit
                        </button>

                        <button @onclick="() => DeleteEmployee(emp.Id)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private EmployeeModel employee = new EmployeeModel();

    private List<EmployeeModel> employees = new();

    private bool isEditing = false;


    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }


    private async Task LoadEmployees()
    {
        employees = await employeeService.GetAll();
    }


    private async Task SaveEmployee()
    {
        await employeeService.Add(employee);

        employee = new EmployeeModel();

        await LoadEmployees();
    }


    private void EditEmployee(EmployeeModel emp)
    {
        employee = new EmployeeModel
        {
            Id = emp.Id,
            Name = emp.Name,
            Email = emp.Email,
            Position = emp.Position
        };

        isEditing = true;
    }


    private async Task UpdateEmployee()
    {
        await employeeService.Update(employee);

        employee = new EmployeeModel();

        isEditing = false;

        await LoadEmployees();
    }


    private void CancelEdit()
    {
        employee = new EmployeeModel();

        isEditing = false;
    }


    private async Task DeleteEmployee(int id)
    {
        await employeeService.Delete(id);

        await LoadEmployees();
    }
}