@page "/attendances"
@using BlazorServer.CrudSqlServer.Services
@using BlazorServer.CrudSqlServer.Models
@rendermode InteractiveServer
@inject AttendanceService attendanceService
@inject EmployeeService employeeService

<h3>Attendance Tracking</h3>
<p class="text-muted">Daily check-in/out, late detection, overtime calculation</p>

<div class="row mb-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6>Today's Summary - @DateTime.Today.ToString("yyyy-MM-dd")</h6>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge bg-success">Present: @todayStats.GetValueOrDefault(AttendanceStatus.Present,0)</span>
                    <span class="badge bg-warning text-dark">Late: @todayStats.GetValueOrDefault(AttendanceStatus.Late,0)</span>
                    <span class="badge bg-danger">Absent: @todayStats.GetValueOrDefault(AttendanceStatus.Absent,0)</span>
                    <span class="badge bg-info">WFH: @todayStats.GetValueOrDefault(AttendanceStatus.WorkFromHome,0)</span>
                    <span class="badge bg-secondary">On Leave: @todayStats.GetValueOrDefault(AttendanceStatus.OnLeave,0)</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">Quick Check-In</label>
                        <select class="form-select" @bind="quickEmployeeId">
                            <option value="0">Select Employee</option>
                            @foreach (var emp in employees)
                            {
                                <option value="@emp.Id">@emp.EmployeeCode - @emp.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Time</label>
                        <input type="time" class="form-control" @bind="quickTime" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end gap-2">
                        <button class="btn btn-success" @onclick="QuickCheckIn" disabled="@(quickEmployeeId==0)">Check In</button>
                        <button class="btn btn-primary" @onclick="QuickCheckOut" disabled="@(quickEmployeeId==0)">Check Out</button>
                        <button class="btn btn-outline-secondary" @onclick="MarkAllPresent">Mark All Present Today</button>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Date Filter</label>
                        <div class="d-flex gap-2">
                            <input type="date" class="form-control" @bind="filterDate" @bind:after="LoadFiltered" />
                            <button class="btn btn-sm btn-outline-primary" @onclick="ClearDateFilter">All</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">@(isEditing ? "Edit Attendance" : "Add Attendance Record")</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Employee *</label>
                <select class="form-select" @bind="attendance.EmployeeId">
                    <option value="0">-- Select --</option>
                    @foreach (var emp in employees)
                    {
                        <option value="@emp.Id">@emp.EmployeeCode - @emp.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Date *</label>
                <input type="date" class="form-control" @bind="attendance.Date" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Check In</label>
                <input type="time" class="form-control" @bind="checkInTime" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Check Out</label>
                <input type="time" class="form-control" @bind="checkOutTime" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select class="form-select" @bind="attendance.Status">
                    @foreach (var st in Enum.GetValues<AttendanceStatus>())
                    {
                        <option value="@st">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Notes</label>
                <input class="form-control" @bind="attendance.Notes" placeholder="e.g. Late due to traffic" />
            </div>
        </div>
        <div class="mt-3">
            @if (isEditing)
            {
                <button class="btn btn-primary me-2" @onclick="UpdateAttendance">Update</button>
                <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
            }
            else
            {
                <button class="btn btn-success" @onclick="SaveAttendance" disabled="@(attendance.EmployeeId==0)">Save Attendance</button>
            }
        </div>
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3">@message</div>
        }
    </div>
</div>

<h4>Attendance Records (@filteredAttendances.Count)</h4>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (!filteredAttendances.Any())
{
    <div class="alert alert-info">No attendance records.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Date</th>
                <th>Employee</th>
                <th>Dept</th>
                <th>Check In</th>
                <th>Check Out</th>
                <th>Hours</th>
                <th>Status</th>
                <th>Flags</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var att in filteredAttendances)
            {
                <tr>
                    <td>@att.Date.ToString("yyyy-MM-dd")<br/><small class="text-muted">@att.Date.ToString("ddd")</small></td>
                    <td><strong>@att.Employee.Name</strong><br/><small class="text-muted">@att.Employee.EmployeeCode</small></td>
                    <td><span class="badge bg-secondary">@(att.Employee.Department?.Name ?? "Unassigned")</span></td>
                    <td>@(att.CheckIn?.ToString(@"HH\:mm") ?? "-")</td>
                    <td>@(att.CheckOut?.ToString(@"HH\:mm") ?? "-")</td>
                    <td>
                        @if (att.HoursWorked.HasValue)
                        {
                            <span class="badge @(att.IsOvertime ? "bg-warning text-dark" : "bg-light text-dark")">@att.HoursWorked.Value.ToString("F1")h</span>
                        }
                        else { <span class="text-muted">-</span> }
                    </td>
                    <td>
                        @switch(att.Status){
                            case AttendanceStatus.Present: <span class="badge bg-success">Present</span>; break;
                            case AttendanceStatus.Absent: <span class="badge bg-danger">Absent</span>; break;
                            case AttendanceStatus.Late: <span class="badge bg-warning text-dark">Late</span>; break;
                            case AttendanceStatus.HalfDay: <span class="badge bg-info">HalfDay</span>; break;
                            case AttendanceStatus.OnLeave: <span class="badge bg-secondary">OnLeave</span>; break;
                            case AttendanceStatus.WorkFromHome: <span class="badge bg-primary">WFH</span>; break;
                            case AttendanceStatus.Sick: <span class="badge bg-dark">Sick</span>; break;
                        }
                    </td>
                    <td>
                        @if(att.IsLate){<span class="badge bg-warning text-dark me-1">Late</span>}
                        @if(att.IsOvertime){<span class="badge bg-success">OT</span>}
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditAttendance(att)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAttendance(att.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private Attendance attendance = new Attendance() { Date = DateTime.Today };
    private List<Attendance> allAttendances = new();
    private List<Attendance> filteredAttendances = new();
    private List<Employee> employees = new();
    private bool isEditing = false;
    private bool isLoading = true;
    private string message = string.Empty;
    private bool isError = false;
    private Dictionary<AttendanceStatus,int> todayStats = new();
    private int quickEmployeeId = 0;
    private TimeOnly quickTime = TimeOnly.FromDateTime(DateTime.Now);
    private DateTime? filterDate = null;
    private TimeOnly? checkInTime = new TimeOnly(8,0);
    private TimeOnly? checkOutTime = new TimeOnly(17,0);

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            employees = await employeeService.GetAll();
            allAttendances = await attendanceService.GetAll();
            filteredAttendances = allAttendances;
            var today = await attendanceService.GetToday();
            todayStats = today.GroupBy(a => a.Status).ToDictionary(g => g.Key, g => g.Count());
        }
        finally { isLoading = false; }
    }

    private async Task LoadFiltered()
    {
        if (filterDate.HasValue)
        {
            var start = filterDate.Value.Date;
            var end = start;
            filteredAttendances = await attendanceService.GetByDateRange(start, end);
        }
        else
        {
            filteredAttendances = allAttendances;
        }
    }

    private void ClearDateFilter(){ filterDate = null; filteredAttendances = allAttendances; }

    private async Task SaveAttendance()
    {
        try
        {
            attendance.CheckIn = checkInTime;
            attendance.CheckOut = checkOutTime;
            await attendanceService.Add(attendance);
            message = "Attendance saved!"; isError = false;
            attendance = new Attendance() { Date = DateTime.Today };
            checkInTime = new TimeOnly(8,0); checkOutTime = new TimeOnly(17,0);
            await LoadData();
        }
        catch (Exception ex){ message = $"Error: {ex.Message}"; isError = true; }
    }

    private void EditAttendance(Attendance att)
    {
        attendance = new Attendance
        {
            Id = att.Id,
            EmployeeId = att.EmployeeId,
            Date = att.Date,
            Status = att.Status,
            Notes = att.Notes
        };
        checkInTime = att.CheckIn;
        checkOutTime = att.CheckOut;
        isEditing = true;
    }

    private async Task UpdateAttendance()
    {
        try
        {
            attendance.CheckIn = checkInTime;
            attendance.CheckOut = checkOutTime;
            await attendanceService.Update(attendance);
            message = "Attendance updated!"; isError = false;
            attendance = new Attendance() { Date = DateTime.Today };
            isEditing = false;
            await LoadData();
        }
        catch (Exception ex){ message = $"Error: {ex.Message}"; isError = true; }
    }

    private void CancelEdit(){ attendance = new Attendance() { Date = DateTime.Today }; isEditing = false; message = string.Empty; }

    private async Task DeleteAttendance(int id){ await attendanceService.Delete(id); await LoadData(); }

    private async Task QuickCheckIn()
    {
        try { await attendanceService.CheckIn(quickEmployeeId, quickTime); message = "Checked in!"; isError = false; await LoadData(); }
        catch (Exception ex){ message = $"Error: {ex.Message}"; isError = true; }
    }

    private async Task QuickCheckOut()
    {
        try { await attendanceService.CheckOut(quickEmployeeId, quickTime); message = "Checked out!"; isError = false; await LoadData(); }
        catch (Exception ex){ message = $"Error: {ex.Message}"; isError = true; }
    }

    private async Task MarkAllPresent()
    {
        try
        {
            var activeIds = employees.Where(e => e.IsActive).Select(e => e.Id).ToList();
            await attendanceService.BulkAddForDate(DateTime.Today, activeIds, AttendanceStatus.Present);
            message = $"Marked {activeIds.Count} employees as present today!"; isError = false;
            await LoadData();
        }
        catch (Exception ex){ message = $"Error: {ex.Message}"; isError = true; }
    }
}
