@page "/salaries"
@using BlazorServer.CrudSqlServer.Services
@using BlazorServer.CrudSqlServer.Models
@using EmployeeModel = BlazorServer.CrudSqlServer.Models.Employee
@rendermode InteractiveServer
@inject SalaryService salaryService
@inject EmployeeService employeeService

<h3>Salary Management</h3>
<p class="text-muted">Track employee salaries and payroll - full history kept</p>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-bg-primary">
            <div class="card-body">
                <h5>Total Monthly Payroll</h5>
                <h3>@totalPayroll.ToString("C", culture)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h6>Payroll by Department</h6>
                @if (payrollByDept.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var kv in payrollByDept)
                        {
                            <span class="badge bg-light text-dark border">@kv.Key: @kv.Value.ToString("C", culture)</span>
                        }
                    </div>
                }
                else
                {
                    <small class="text-muted">No salary data yet</small>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        @(isEditing ? "Edit Salary Record" : "Add Salary Record")
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Employee *</label>
                <select class="form-select" @bind="salary.EmployeeId">
                    <option value="0">-- Select Employee --</option>
                    @foreach (var emp in employees)
                    {
                        <option value="@emp.Id">@emp.EmployeeCode - @emp.Name (@emp.Department?.Name)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Basic Salary *</label>
                <input type="number" class="form-control" @bind="salary.BasicSalary" step="0.01" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Bonus</label>
                <input type="number" class="form-control" @bind="salary.Bonus" step="0.01" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Deductions</label>
                <input type="number" class="form-control" @bind="salary.Deductions" step="0.01" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Net</label>
                <input class="form-control" value="@salary.NetSalary.ToString("C", culture)" disabled />
            </div>
            <div class="col-md-2">
                <label class="form-label">Pay Grade</label>
                <input class="form-control" placeholder="A1, B2" @bind="salary.PayGrade" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Currency</label>
                <select class="form-select" @bind="salary.Currency">
                    <option>ZAR</option>
                    <option>USD</option>
                    <option>EUR</option>
                    <option>GBP</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Effective From *</label>
                <input type="date" class="form-control" @bind="salary.EffectiveFrom" />
            </div>
        </div>
        <div class="mt-3">
            @if (isEditing)
            {
                <button class="btn btn-primary me-2" @onclick="UpdateSalary">Update</button>
                <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
            }
            else
            {
                <button class="btn btn-success" @onclick="SaveSalary" disabled="@(salary.EmployeeId == 0 || salary.BasicSalary <= 0)">Save Salary</button>
            }
        </div>
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3">@message</div>
        }
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4>Salary History (@filteredSalaries.Count)</h4>
    <div>
        <label>Filter by Employee: </label>
        <select @bind="filterEmployeeId" @bind:after="ApplyFilter" class="form-select form-select-sm d-inline-block w-auto ms-2">
            <option value="0">All Employees</option>
            @foreach (var emp in employees)
            {
                <option value="@emp.Id">@emp.Name</option>
            }
        </select>
    </div>
</div>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (!filteredSalaries.Any())
{
    <div class="alert alert-info">No salary records found.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Employee</th>
                <th>Dept</th>
                <th>Basic</th>
                <th>Bonus</th>
                <th>Deductions</th>
                <th>Net</th>
                <th>Grade</th>
                <th>Effective From</th>
                <th>To</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sal in filteredSalaries)
            {
                <tr class="@(sal.EffectiveTo == null || sal.EffectiveTo > DateTime.UtcNow ? "table-success" : "")">
                    <td><strong>@sal.Employee.Name</strong><br/><small class="text-muted">@sal.Employee.EmployeeCode</small></td>
                    <td><span class="badge bg-secondary">@(sal.Employee.Department?.Name ?? "Unassigned")</span></td>
                    <td>@sal.BasicSalary.ToString("C", culture)</td>
                    <td class="text-success">+@sal.Bonus.ToString("C", culture)</td>
                    <td class="text-danger">-@sal.Deductions.ToString("C", culture)</td>
                    <td><strong>@sal.NetSalary.ToString("C", culture)</strong></td>
                    <td><span class="badge bg-info">@sal.PayGrade</span></td>
                    <td>@sal.EffectiveFrom.ToString("yyyy-MM-dd")</td>
                    <td>@(sal.EffectiveTo?.ToString("yyyy-MM-dd") ?? "Current")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditSalary(sal)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSalary(sal.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private Salary salary = new Salary() { EffectiveFrom = DateTime.UtcNow, Currency = "ZAR" };
    private List<Salary> allSalaries = new();
    private List<Salary> filteredSalaries = new();
    private List<EmployeeModel> employees = new();
    private bool isEditing = false;
    private bool isLoading = true;
    private string message = string.Empty;
    private bool isError = false;
    private decimal totalPayroll = 0;
    private Dictionary<string, decimal> payrollByDept = new();
    private int filterEmployeeId = 0;
    private System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("en-ZA");

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            employees = await employeeService.GetAll();
            allSalaries = await salaryService.GetAll();
            filteredSalaries = allSalaries;
            totalPayroll = await salaryService.GetTotalPayroll();
            payrollByDept = await salaryService.GetPayrollByDepartment();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilter()
    {
        if (filterEmployeeId == 0)
            filteredSalaries = allSalaries;
        else
            filteredSalaries = allSalaries.Where(s => s.EmployeeId == filterEmployeeId).ToList();
    }

    private async Task SaveSalary()
    {
        try
        {
            await salaryService.Add(salary);
            message = $"Salary for employee added! Net: {salary.NetSalary.ToString("C", culture)}";
            isError = false;
            salary = new Salary() { EffectiveFrom = DateTime.UtcNow, Currency = "ZAR" };
            await LoadData();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            isError = true;
        }
    }

    private void EditSalary(Salary sal)
    {
        salary = new Salary
        {
            Id = sal.Id,
            EmployeeId = sal.EmployeeId,
            BasicSalary = sal.BasicSalary,
            Bonus = sal.Bonus,
            Deductions = sal.Deductions,
            PayGrade = sal.PayGrade,
            Currency = sal.Currency,
            EffectiveFrom = sal.EffectiveFrom,
            EffectiveTo = sal.EffectiveTo,
        };
        isEditing = true;
    }

    private async Task UpdateSalary()
    {
        try
        {
            await salaryService.Update(salary);
            message = "Salary updated!";
            isError = false;
            salary = new Salary() { EffectiveFrom = DateTime.UtcNow, Currency = "ZAR" };
            isEditing = false;
            await LoadData();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            isError = true;
        }
    }

    private void CancelEdit()
    {
        salary = new Salary() { EffectiveFrom = DateTime.UtcNow, Currency = "ZAR" };
        isEditing = false;
        message = string.Empty;
    }

    private async Task DeleteSalary(int id)
    {
        try
        {
            await salaryService.Delete(id);
            message = "Salary record deleted.";
            isError = false;
            await LoadData();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            isError = true;
        }
    }
}
