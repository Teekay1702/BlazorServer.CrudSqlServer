@page "/leaves"
@using BlazorServer.CrudSqlServer.Services
@using BlazorServer.CrudSqlServer.Models
@rendermode InteractiveServer
@inject LeaveService leaveService
@inject EmployeeService employeeService

<h3>Leave Management</h3>
<p class="text-muted">Track annual, sick, maternity and other leave - with approval workflow</p>

<div class="row mb-3">
    <div class="col-md-3">
        <div class="card text-bg-warning">
            <div class="card-body">
                <h6>Pending Requests</h6>
                <h3>@pendingCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-9">
        <div class="card">
            <div class="card-body">
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge bg-warning text-dark">Pending: @leaves.Count(l => l.Status == LeaveStatus.Pending)</span>
                    <span class="badge bg-success">Approved: @leaves.Count(l => l.Status == LeaveStatus.Approved)</span>
                    <span class="badge bg-danger">Rejected: @leaves.Count(l => l.Status == LeaveStatus.Rejected)</span>
                    <span class="badge bg-secondary">Cancelled: @leaves.Count(l => l.Status == LeaveStatus.Cancelled)</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">@(isEditing ? "Edit Leave Request" : "New Leave Request")</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Employee *</label>
                <select class="form-select" @bind="leave.EmployeeId">
                    <option value="0">-- Select --</option>
                    @foreach (var emp in employees)
                    {
                        <option value="@emp.Id">@emp.EmployeeCode - @emp.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Leave Type</label>
                <select class="form-select" @bind="leave.LeaveType">
                    @foreach (var lt in Enum.GetValues<LeaveType>())
                    {
                        <option value="@lt">@lt</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Start Date *</label>
                <input type="date" class="form-control" @bind="leave.StartDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label">End Date *</label>
                <input type="date" class="form-control" @bind="leave.EndDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Reason *</label>
                <input class="form-control" placeholder="Reason for leave" @bind="leave.Reason" />
            </div>
            <div class="col-md-2">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" @bind="leave.IsHalfDay" id="halfDayCheck" />
                    <label class="form-check-label" for="halfDayCheck">Half Day</label>
                </div>
            </div>
        </div>
        <div class="mt-3">
            @if (isEditing)
            {
                <button class="btn btn-primary me-2" @onclick="UpdateLeave">Update</button>
                <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
            }
            else
            {
                <button class="btn btn-success" @onclick="SaveLeave" disabled="@(leave.EmployeeId==0 || string.IsNullOrWhiteSpace(leave.Reason))">Submit Request</button>
            }
        </div>
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3">@message</div>
        }
    </div>
</div>

<div class="d-flex justify-content-between mb-2">
    <h4>Leave Requests (@filteredLeaves.Count)</h4>
    <div class="d-flex gap-2">
        <select class="form-select form-select-sm" @bind="filterStatus" @bind:after="ApplyFilter" style="width:150px">
            <option value="">All Status</option>
            @foreach (var s in Enum.GetValues<LeaveStatus>())
            {
                <option value="@s">@s</option>
            }
        </select>
        <select class="form-select form-select-sm" @bind="filterEmployee" @bind:after="ApplyFilter" style="width:180px">
            <option value="0">All Employees</option>
            @foreach (var emp in employees)
            {
                <option value="@emp.Id">@emp.Name</option>
            }
        </select>
    </div>
</div>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (!filteredLeaves.Any())
{
    <div class="alert alert-info">No leave requests found.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Employee</th>
                <th>Type</th>
                <th>Dates</th>
                <th>Days</th>
                <th>Reason</th>
                <th>Status</th>
                <th>Requested</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lr in filteredLeaves)
            {
                <tr>
                    <td><strong>@lr.Employee.Name</strong><br/><small class="text-muted">@lr.Employee.EmployeeCode - @(lr.Employee.Department?.Name)</small></td>
                    <td><span class="badge bg-info">@lr.LeaveType</span></td>
                    <td>@lr.StartDate.ToString("yyyy-MM-dd")<br/>to @lr.EndDate.ToString("yyyy-MM-dd") @if(lr.IsHalfDay){<span class="badge bg-secondary">Half</span>}</td>
                    <td><span class="badge bg-dark">@lr.TotalDays</span></td>
                    <td>@lr.Reason</td>
                    <td>
                        @switch(lr.Status){
                            case LeaveStatus.Pending: <span class="badge bg-warning text-dark">Pending</span>; break;
                            case LeaveStatus.Approved: <span class="badge bg-success">Approved</span>; break;
                            case LeaveStatus.Rejected: <span class="badge bg-danger">Rejected</span>; break;
                            case LeaveStatus.Cancelled: <span class="badge bg-secondary">Cancelled</span>; break;
                        }
                        @if(!string.IsNullOrEmpty(lr.ReviewedBy)){<br/><small class="text-muted">by @lr.ReviewedBy</small>}
                    </td>
                    <td>@lr.RequestedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if(lr.Status == LeaveStatus.Pending)
                        {
                            <button class="btn btn-sm btn-success me-1" @onclick="() => ApproveLeave(lr.Id)">Approve</button>
                            <button class="btn btn-sm btn-danger me-1" @onclick="() => RejectLeave(lr.Id)">Reject</button>
                        }
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditLeave(lr)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteLeave(lr.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private LeaveRequest leave = new LeaveRequest() { StartDate = DateTime.Today, EndDate = DateTime.Today.AddDays(1) };
    private List<LeaveRequest> leaves = new();
    private List<LeaveRequest> filteredLeaves = new();
    private List<Employee> employees = new();
    private bool isEditing = false;
    private bool isLoading = true;
    private string message = string.Empty;
    private bool isError = false;
    private int pendingCount = 0;
    private string filterStatus = string.Empty;
    private int filterEmployee = 0;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            employees = await employeeService.GetAll();
            leaves = await leaveService.GetAll();
            filteredLeaves = leaves;
            pendingCount = leaves.Count(l => l.Status == LeaveStatus.Pending);
        }
        finally { isLoading = false; }
    }

    private void ApplyFilter()
    {
        var q = leaves.AsEnumerable();
        if (!string.IsNullOrEmpty(filterStatus) && Enum.TryParse<LeaveStatus>(filterStatus, out var st))
            q = q.Where(l => l.Status == st);
        if (filterEmployee != 0)
            q = q.Where(l => l.EmployeeId == filterEmployee);
        filteredLeaves = q.ToList();
    }

    private async Task SaveLeave()
    {
        try
        {
            await leaveService.Add(leave);
            message = $"Leave request submitted for {leave.TotalDays} day(s)!";
            isError = false;
            leave = new LeaveRequest() { StartDate = DateTime.Today, EndDate = DateTime.Today.AddDays(1) };
            await LoadData(); ApplyFilter();
        }
        catch (Exception ex){ message = $"Error: {ex.Message}"; isError = true; }
    }

    private void EditLeave(LeaveRequest lr)
    {
        leave = new LeaveRequest
        {
            Id = lr.Id,
            EmployeeId = lr.EmployeeId,
            LeaveType = lr.LeaveType,
            StartDate = lr.StartDate,
            EndDate = lr.EndDate,
            IsHalfDay = lr.IsHalfDay,
            Reason = lr.Reason,
            Status = lr.Status,
            RequestedAt = lr.RequestedAt
        };
        isEditing = true;
    }

    private async Task UpdateLeave()
    {
        try
        {
            await leaveService.Update(leave);
            message = "Leave updated!"; isError = false;
            leave = new LeaveRequest() { StartDate = DateTime.Today, EndDate = DateTime.Today.AddDays(1) };
            isEditing = false;
            await LoadData(); ApplyFilter();
        }
        catch (Exception ex){ message = $"Error: {ex.Message}"; isError = true; }
    }

    private void CancelEdit(){ leave = new LeaveRequest() { StartDate = DateTime.Today, EndDate = DateTime.Today.AddDays(1) }; isEditing = false; message = string.Empty; }

    private async Task ApproveLeave(int id)
    {
        await leaveService.Approve(id, "HR Manager", "Approved");
        await LoadData(); ApplyFilter();
    }

    private async Task RejectLeave(int id)
    {
        await leaveService.Reject(id, "HR Manager", "Insufficient balance or conflict");
        await LoadData(); ApplyFilter();
    }

    private async Task DeleteLeave(int id)
    {
        await leaveService.Delete(id);
        await LoadData(); ApplyFilter();
    }
}
