@page "/payrolls"
@using BlazorServer.CrudSqlServer.Services
@using BlazorServer.CrudSqlServer.Models
@rendermode InteractiveServer
@inject PayrollService payrollService
@inject EmployeeService employeeService
@inject SalaryService salaryService

<h3>Payroll Management</h3>
<p class="text-muted">Generate monthly payroll from current salaries, track overtime, process payments</p>

<div class="row mb-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6>Generate Payroll</h6>
                <div class="row g-2">
                    <div class="col-4">
                        <label class="form-label">Year</label>
                        <input type="number" class="form-control" @bind="genYear" />
                    </div>
                    <div class="col-4">
                        <label class="form-label">Month</label>
                        <select class="form-select" @bind="genMonth">
                            @for (int m = 1; m <= 12; m++){ <option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option> }
                        </select>
                    </div>
                    <div class="col-4 d-flex align-items-end">
                        <button class="btn btn-success w-100" @onclick="GenerateAllPayroll">Generate All Active</button>
                    </div>
                </div>
                <small class="text-muted">Generates payroll for all active employees with active salary. Skips existing.</small>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="row g-2">
            <div class="col-md-4">
                <div class="card text-bg-primary">
                    <div class="card-body">
                        <h6>Current Period Total</h6>
                        <h4>@periodTotal.ToString("C", culture)</h4>
                        <small>@filterYear-@filterMonth.ToString("D2")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <h6>By Department - @filterYear-@filterMonth.ToString("D2")</h6>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var kv in deptTotals)
                            {
                                <span class="badge bg-light text-dark border">@kv.Key: @kv.Value.ToString("C", culture)</span>
                            }
                        </div>
                        <div class="mt-2">
                            <span class="badge bg-warning text-dark">Draft: @payrolls.Count(p => p.Status==PayrollStatus.Draft && p.Year==filterYear && p.Month==filterMonth)</span>
                            <span class="badge bg-info">Processed: @payrolls.Count(p => p.Status==PayrollStatus.Processed && p.Year==filterYear && p.Month==filterMonth)</span>
                            <span class="badge bg-success">Paid: @payrolls.Count(p => p.Status==PayrollStatus.Paid && p.Year==filterYear && p.Month==filterMonth)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">@(isEditing ? "Edit Payroll" : "Manual Payroll Entry")</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Employee *</label>
                <select class="form-select" @bind="payroll.EmployeeId">
                    <option value="0">-- Select --</option>
                    @foreach (var emp in employees)
                    {
                        <option value="@emp.Id">@emp.EmployeeCode - @emp.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label">Year</label>
                <input type="number" class="form-control" @bind="payroll.Year" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Month</label>
                <select class="form-select" @bind="payroll.Month">
                    @for (int m = 1; m <= 12; m++){ <option value="@m">@m</option> }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Basic</label>
                <input type="number" class="form-control" @bind="payroll.BasicSalary" step="0.01" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Bonus</label>
                <input type="number" class="form-control" @bind="payroll.Bonus" step="0.01" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Ded.</label>
                <input type="number" class="form-control" @bind="payroll.Deductions" step="0.01" />
            </div>
            <div class="col-md-1">
                <label class="form-label">OT Hours</label>
                <input type="number" class="form-control" @bind="payroll.OvertimeHours" step="0.5" />
            </div>
            <div class="col-md-1">
                <label class="form-label">OT Rate</label>
                <input type="number" class="form-control" @bind="payroll.OvertimeRate" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Net Preview</label>
                <input class="form-control fw-bold" value="@payroll.NetPay.ToString("C", culture)" disabled />
            </div>
            <div class="col-md-2">
                <label class="form-label">Method</label>
                <select class="form-select" @bind="payroll.PaymentMethod">
                    <option>EFT</option>
                    <option>Cash</option>
                    <option>Cheque</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Reference</label>
                <input class="form-control" @bind="payroll.Reference" placeholder="PAY-202609-EMP0001" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Notes</label>
                <input class="form-control" @bind="payroll.Notes" />
            </div>
        </div>
        <div class="mt-3">
            @if (isEditing)
            {
                <button class="btn btn-primary me-2" @onclick="UpdatePayroll">Update</button>
                <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
            }
            else
            {
                <button class="btn btn-success" @onclick="SavePayroll" disabled="@(payroll.EmployeeId==0 || payroll.BasicSalary<=0)">Save Payroll</button>
            }
        </div>
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3">@message</div>
        }
    </div>
</div>

<div class="d-flex justify-content-between mb-2">
    <h4>Payroll Records (@filteredPayrolls.Count)</h4>
    <div class="d-flex gap-2">
        <input type="number" class="form-control form-control-sm" style="width:80px" @bind="filterYear" @bind:after="ApplyFilter" placeholder="Year" />
        <select class="form-select form-select-sm" style="width:120px" @bind="filterMonth" @bind:after="ApplyFilter">
            <option value="0">All Months</option>
            @for (int m = 1; m <= 12; m++){ <option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m).Substring(0,3)</option> }
        </select>
        <select class="form-select form-select-sm" style="width:130px" @bind="filterStatus" @bind:after="ApplyFilter">
            <option value="">All Status</option>
            @foreach (var s in Enum.GetValues<PayrollStatus>()){ <option value="@s">@s</option> }
        </select>
    </div>
</div>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (!filteredPayrolls.Any())
{
    <div class="alert alert-info">No payroll records for selected filters. Generate payroll above.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Period</th>
                <th>Employee</th>
                <th>Dept</th>
                <th>Basic</th>
                <th>Bonus</th>
                <th>OT</th>
                <th>Deductions</th>
                <th>Gross</th>
                <th>Net</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in filteredPayrolls)
            {
                <tr>
                    <td><span class="badge bg-dark">@p.Period</span></td>
                    <td><strong>@p.Employee.Name</strong><br/><small class="text-muted">@p.Employee.EmployeeCode</small></td>
                    <td><span class="badge bg-secondary">@(p.Employee.Department?.Name ?? "Unassigned")</span></td>
                    <td>@p.BasicSalary.ToString("C", culture)</td>
                    <td class="text-success">+@p.Bonus.ToString("C", culture)</td>
                    <td>@p.OvertimeHours h<br/><small>@p.OvertimePay.ToString("C", culture)</small></td>
                    <td class="text-danger">-@p.Deductions.ToString("C", culture)</td>
                    <td>@p.GrossPay.ToString("C", culture)</td>
                    <td><strong>@p.NetPay.ToString("C", culture)</strong></td>
                    <td>
                        @switch(p.Status){
                            case PayrollStatus.Draft: <span class="badge bg-warning text-dark">Draft</span>; break;
                            case PayrollStatus.Processed: <span class="badge bg-info">Processed</span>; break;
                            case PayrollStatus.Paid: <span class="badge bg-success">Paid</span>; break;
                            case PayrollStatus.Cancelled: <span class="badge bg-secondary">Cancelled</span>; break;
                        }
                        <br/><small class="text-muted">@p.PaymentMethod</small>
                    </td>
                    <td>
                        <div class="btn-group-vertical btn-group-sm">
                            @if(p.Status == PayrollStatus.Draft){<button class="btn btn-sm btn-outline-info" @onclick="() => ProcessPayroll(p.Id)">Process</button>}
                            @if(p.Status == PayrollStatus.Processed){<button class="btn btn-sm btn-outline-success" @onclick="() => PayPayroll(p.Id)">Mark Paid</button>}
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditPayroll(p)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePayroll(p.Id)">Delete</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot class="table-light">
            <tr>
                <th colspan="7" class="text-end">Total Net for filtered:</th>
                <th colspan="2">@filteredPayrolls.Sum(p => p.NetPay).ToString("C", culture)</th>
                <th colspan="2"></th>
            </tr>
        </tfoot>
    </table>
}

@code {
    private Payroll payroll = new Payroll() { Year = DateTime.Today.Year, Month = DateTime.Today.Month, PaymentMethod = "EFT" };
    private List<Payroll> payrolls = new();
    private List<Payroll> filteredPayrolls = new();
    private List<Employee> employees = new();
    private bool isEditing = false;
    private bool isLoading = true;
    private string message = string.Empty;
    private bool isError = false;
    private int genYear = DateTime.Today.Year;
    private int genMonth = DateTime.Today.Month;
    private int filterYear = DateTime.Today.Year;
    private int filterMonth = 0;
    private string filterStatus = string.Empty;
    private decimal periodTotal = 0;
    private Dictionary<string, decimal> deptTotals = new();
    private System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("en-ZA");

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            employees = await employeeService.GetAll();
            payrolls = await payrollService.GetAll();
            ApplyFilter();
            await UpdatePeriodStats();
        }
        finally { isLoading = false; }
    }

    private void ApplyFilter()
    {
        var q = payrolls.AsEnumerable();
        if (filterYear != 0) q = q.Where(p => p.Year == filterYear);
        if (filterMonth != 0) q = q.Where(p => p.Month == filterMonth);
        if (!string.IsNullOrEmpty(filterStatus) && Enum.TryParse<PayrollStatus>(filterStatus, out var st))
            q = q.Where(p => p.Status == st);
        filteredPayrolls = q.OrderByDescending(p => p.Year).ThenByDescending(p => p.Month).ThenBy(p => p.Employee.Name).ToList();
    }

    private async Task UpdatePeriodStats()
    {
        if (filterMonth != 0)
        {
            periodTotal = await payrollService.GetTotalForPeriod(filterYear, filterMonth);
            deptTotals = await payrollService.GetByDepartmentForPeriod(filterYear, filterMonth);
        }
        else
        {
            periodTotal = payrolls.Where(p => p.Year == filterYear).Sum(p => p.NetPay);
            deptTotals = payrolls.Where(p => p.Year == filterYear).GroupBy(p => p.Employee.Department?.Name ?? "Unassigned").ToDictionary(g => g.Key, g => g.Sum(p => p.NetPay));
        }
    }

    private async Task GenerateAllPayroll()
    {
        try
        {
            var results = await payrollService.GenerateForAll(genYear, genMonth);
            message = $"Generated {results.Count} payroll records for {genYear}-{genMonth:D2}!";
            isError = false;
            await LoadData();
        }
        catch (Exception ex){ message = $"Error: {ex.Message}"; isError = true; }
    }

    private async Task SavePayroll()
    {
        try
        {
            payroll.Reference = string.IsNullOrWhiteSpace(payroll.Reference) ? $"PAY-{payroll.Year}{payroll.Month:D2}-{employees.FirstOrDefault(e => e.Id==payroll.EmployeeId)?.EmployeeCode}" : payroll.Reference;
            // Need to set via service add - we don't have Add, so use context via Update pattern? We'll use Generate logic manually via context
            // For manual entry, we directly add via service Update workaround - let's call context via service
            await payrollService.GenerateForEmployee(payroll.EmployeeId, payroll.Year, payroll.Month, payroll.OvertimeHours);
            // Then update with custom values
            var created = (await payrollService.GetByPeriod(payroll.Year, payroll.Month)).FirstOrDefault(p => p.EmployeeId==payroll.EmployeeId);
            if (created != null)
            {
                created.BasicSalary = payroll.BasicSalary;
                created.Bonus = payroll.Bonus;
                created.Deductions = payroll.Deductions;
                created.OvertimeHours = payroll.OvertimeHours;
                created.OvertimeRate = payroll.OvertimeRate;
                created.PaymentMethod = payroll.PaymentMethod;
                created.Reference = payroll.Reference;
                created.Notes = payroll.Notes;
                await payrollService.Update(created);
            }
            message = $"Payroll saved for {payroll.Period}!";
            isError = false;
            payroll = new Payroll() { Year = DateTime.Today.Year, Month = DateTime.Today.Month, PaymentMethod = "EFT" };
            await LoadData();
        }
        catch (Exception ex)
        {
            // Fallback manual save if already exists try update
            try
            {
                var existing = payrolls.FirstOrDefault(p => p.EmployeeId==payroll.EmployeeId && p.Year==payroll.Year && p.Month==payroll.Month);
                if (existing != null)
                {
                    existing.BasicSalary = payroll.BasicSalary;
                    existing.Bonus = payroll.Bonus;
                    existing.Deductions = payroll.Deductions;
                    existing.OvertimeHours = payroll.OvertimeHours;
                    existing.OvertimeRate = payroll.OvertimeRate;
                    existing.PaymentMethod = payroll.PaymentMethod;
                    existing.Reference = payroll.Reference;
                    existing.Notes = payroll.Notes;
                    await payrollService.Update(existing);
                    message = $"Payroll updated for {payroll.Period}!";
                    isError = false;
                    payroll = new Payroll() { Year = DateTime.Today.Year, Month = DateTime.Today.Month, PaymentMethod = "EFT" };
                    await LoadData();
                    return;
                }
                throw;
            }
            catch
            {
                message = $"Error: {ex.Message}"; isError = true;
            }
        }
    }

    private void EditPayroll(Payroll p)
    {
        payroll = new Payroll
        {
            Id = p.Id,
            EmployeeId = p.EmployeeId,
            Year = p.Year,
            Month = p.Month,
            BasicSalary = p.BasicSalary,
            Bonus = p.Bonus,
            Deductions = p.Deductions,
            OvertimeHours = p.OvertimeHours,
            OvertimeRate = p.OvertimeRate,
            PaymentMethod = p.PaymentMethod,
            Reference = p.Reference,
            Notes = p.Notes,
            Status = p.Status,
            PayDate = p.PayDate
        };
        isEditing = true;
    }

    private async Task UpdatePayroll()
    {
        try
        {
            var existing = await payrollService.GetById(payroll.Id);
            if (existing != null)
            {
                existing.BasicSalary = payroll.BasicSalary;
                existing.Bonus = payroll.Bonus;
                existing.Deductions = payroll.Deductions;
                existing.OvertimeHours = payroll.OvertimeHours;
                existing.OvertimeRate = payroll.OvertimeRate;
                existing.PaymentMethod = payroll.PaymentMethod;
                existing.Reference = payroll.Reference;
                existing.Notes = payroll.Notes;
                await payrollService.Update(existing);
                message = "Payroll updated!"; isError = false;
                payroll = new Payroll() { Year = DateTime.Today.Year, Month = DateTime.Today.Month, PaymentMethod = "EFT" };
                isEditing = false;
                await LoadData();
            }
        }
        catch (Exception ex){ message = $"Error: {ex.Message}"; isError = true; }
    }

    private void CancelEdit(){ payroll = new Payroll() { Year = DateTime.Today.Year, Month = DateTime.Today.Month, PaymentMethod = "EFT" }; isEditing = false; message = string.Empty; }

    private async Task ProcessPayroll(int id){ await payrollService.Process(id); await LoadData(); }
    private async Task PayPayroll(int id){ await payrollService.MarkAsPaid(id); await LoadData(); }
    private async Task DeletePayroll(int id){ await payrollService.Delete(id); await LoadData(); }
}
